# Auth.js (next-auth v5)
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL (used for OG metadata base; defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CloudFront CDN (set when provisioned)
NEXT_PUBLIC_CLOUDFRONT_URL=

# AWS Cognito
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=
AWS_COGNITO_ISSUER=
# Cognito group whose members may open the Sanity Studio. Case-sensitive.
COGNITO_ADMIN_GROUP=admins

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
