# Network resilience for `npm ci` inside Docker builds. The frontend pulls a
# large dependency tree (Sanity Studio), so a single dropped TLS socket on a
# flaky connection would otherwise fail the whole install. Retry hard before
# giving up rather than aborting a ~15-minute build on one ECONNRESET.
fetch-retries=6
fetch-retry-factor=2
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
