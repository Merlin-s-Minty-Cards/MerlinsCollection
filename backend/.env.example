AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DYNAMODB_TABLE_NAME=merlins-cards
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Relative paths resolve against backend/; use an absolute path in production
MCP_SERVER_PATH=../mcp-server/dist/index.js
POKEMONTCG_API_KEY=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Dev only: bypass Cognito auth with a fake user. NEVER set in production.
AUTH_DISABLED=false

# --- App-side rate limiting (DynamoDB-backed & distributed; keyed per Cognito
# user, client IP in dev). Correct across restarts/redeploys/multiple instances.
# See rate_limit.py. ---
# Master switch (ops kill-switch). Keep true in production.
RATE_LIMIT_ENABLED=true
# Dedicated DynamoDB table for the counters — SEPARATE from the business
# `merlins-cards` table so ephemeral counters are never swept as business data.
# The table has a single string partition key `PK` and a numeric `expires_at`
# TTL attribute. TTL must be ENABLED ON THE TABLE BY HAND (there is no IaC):
#   aws dynamodb update-time-to-live --table-name merlins-rate-limits \
#     --time-to-live-specification "Enabled=true,AttributeName=expires_at"
RATE_LIMIT_TABLE_NAME=merlins-rate-limits
# "<count>/<period>" syntax (period: second/minute/hour/day). /chat hits Bedrock
# (real $ per call): a per-minute burst cap plus a per-USER per-day ceiling.
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_CHAT_DAILY=200/day
# GLOBAL account-wide daily /chat cap across ALL users combined. Bounds worst-
# case daily Bedrock cost even if Cognito self-signup is open. This is a FIXED
# epoch-day window: a stream straddling UTC midnight can spend the cap twice in
# ~1-2 min, so the TRUE worst case is 2x this value. Set it to HALF the tolerable
# daily Bedrock spend (default 1000 → true worst-case ceiling ~2000 calls/24h).
RATE_LIMIT_CHAT_GLOBAL_DAILY=1000/day
# Cheaper endpoints get looser limits.
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_AUTH=30/minute
